{
  "rules": {
    ".read": false,
    ".write": false,

    "games": {
      ".read": true,
      "$gameCode": {
        ".read": true,
        ".write": true
      }
    },

    "gameHistory": {
      ".read": true,
      ".write": false,
      "$entry": {
        // Allow only new pushes — existing entries cannot be modified or deleted
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['ts', 'mode', 'numPlayers', 'players', 'actsCompleted', 'totalRounds'])",

        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "mode": {
          ".validate": "newData.isString() && (newData.val() === 'mp' || newData.val() === 'ai')"
        },
        "numPlayers": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 8"
        },
        "actsCompleted": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "totalRounds": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 15"
        },
        // winner is optional (null = tie); gameCode is optional (absent in SP)
        "winner": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "gameCode": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },

        "players": {
          "$playerIdx": {
            ".validate": "newData.hasChildren(['name', 'isHuman', 'herd', 'isWinner'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "isHuman": {
              ".validate": "newData.isBoolean()"
            },
            "herd": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "isWinner": {
              ".validate": "newData.isBoolean()"
            },
            // Reject any unexpected fields on player entries
            "$other": { ".validate": false }
          }
        },

        // Reject any unexpected top-level fields on history entries
        "$other": { ".validate": false }
      }
    },

    "decisionLog": {
      // Research data: per-decision human-vs-shadow-AI records, keyed by game code.
      // Read-only via the Firebase CLI (owner creds bypass rules); never read by clients.
      // Append-only pushes; each record shape-validated (union of 'draw' + 'buy' fields).
      ".read": false,
      "$gameCode": {
        "$entry": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['ts', 'kind'])",

          "ts":   { ".validate": "newData.isNumber() && newData.val() > 0" },
          "kind": { ".validate": "newData.isString() && (newData.val() === 'draw' || newData.val() === 'buy')" },
          "mode": { ".validate": "newData.isString() && (newData.val() === 'mp' || newData.val() === 'ai')" },
          "player": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
          "act":   { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
          "dollars": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },

          "bandits": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "cows":    { ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 200" },
          "handSize": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
          "deckRemaining": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
          "lethalNext": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
          "bustProb": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
          "humanDrew":   { ".validate": "newData.isBoolean()" },
          "aiWouldDraw": { ".validate": "newData.isBoolean()" },

          "humanAction": { ".validate": "newData.isString() && (newData.val() === 'buy' || newData.val() === 'burn')" },
          "humanCardId": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "aiAction":  { ".validate": "newData.isString() && (newData.val() === 'buy' || newData.val() === 'burn')" },
          "aiCardId":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "humanPickRank": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
          "numAffordable": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
          "numAvailable":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },

          "$other": { ".validate": false }
        }
      }
    },

    "traj": {
      // Durable replayable trajectory capture (Phase 0) — header + per-round deck
      // snapshots + ordered decision events + canaries, keyed by game code then push.
      // Read-only via the Firebase CLI; never read by clients. Append-only; each record
      // shape-validated over the union of record-kind fields with $other:false.
      ".read": false,
      "$gameCode": {
        "$entry": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['ts', 'kind'])",

          "ts":   { ".validate": "newData.isNumber() && newData.val() > 0" },
          "kind": { ".validate": "newData.isString() && newData.val().length <= 6" },

          "schemaV":    { ".validate": "newData.isNumber()" },
          "gameV":      { ".validate": "newData.isNumber()" },
          "cardDbHash": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "mode":       { ".validate": "newData.isString() && newData.val().length <= 4" },
          "gameSeed":   { ".validate": "newData.isNumber()" },
          "numPlayers": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
          "quickStartMode": { ".validate": "newData.isBoolean()" },
          "hiddenHerdMode": { ".validate": "newData.isBoolean()" },
          "seats": {
            "$slot": {
              ".validate": "newData.hasChildren(['isHuman'])",
              "isHuman":     { ".validate": "newData.isBoolean()" },
              "personality": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "$other": { ".validate": false }
            }
          },

          "act":   { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
          "slot":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
          "herd":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },

          "cardIds": { "$i": { ".validate": "newData.isString() && newData.val().length <= 20" } },
          "deck":    { "$i": { ".validate": "newData.isString() && newData.val().length <= 20" } },
          "hand":    { "$i": { ".validate": "newData.isString() && newData.val().length <= 20" } },
          "discard": { "$i": { ".validate": "newData.isString() && newData.val().length <= 20" } },

          "action":  { ".validate": "newData.isString() && newData.val().length <= 5" },
          "drew":    { ".validate": "newData.isString() && newData.val().length <= 20" },
          "special": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "cardId":  { ".validate": "newData.isString() && newData.val().length <= 20" },
          "detail":  { ".validate": "newData.isString() && newData.val().length <= 20" },
          "row": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
          "col": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },

          "herds":         { "$slot": { ".validate": "newData.isNumber()" } },
          "deckCounts":    { "$slot": { ".validate": "newData.isNumber()" } },
          "discardCounts": { "$slot": { ".validate": "newData.isNumber()" } },

          "$other": { ".validate": false }
        }
      }
    },

    "liveGames": {
      ".read": true,
      "$gameCode": {
        ".read": true,
        ".write": true
      }
    },

    "liveSummary": {
      ".read": true,
      "$gameCode": {
        ".read": true,
        ".write": true
      }
    },

    "emailSignups": {
      ".read": false,
      "$entry": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email', 'ts'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 254 && newData.val().matches(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/)"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": { ".validate": false }
      }
    },

    "bugReports": {
      ".read": false,
      "$entry": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['message', 'ts'])",
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "gameCode": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "context": {
          ".validate": "newData.isString() && newData.val().length <= 20000"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
